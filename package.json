{
  "name": "@arraypress/security-headers",
  "version": "2.1.0",
  "description": "Security response headers for static hosts — CSP, HSTS, X-Frame-Options, Referrer-Policy, Permissions-Policy. Generates a Cloudflare/Netlify _headers file, with an Astro integration that derives a strict, hash-based CSP from the finished build. Zero dependencies.",
  "type": "module",
  "main": "src/index.js",
  "types": "src/index.d.ts",
  "exports": {
    ".": {
      "import": "./src/index.js",
      "types": "./src/index.d.ts"
    },
    "./scan": {
      "import": "./src/scan.js",
      "types": "./src/scan.d.ts"
    },
    "./astro": {
      "import": "./src/astro.js",
      "types": "./src/astro.d.ts"
    }
  },
  "files": [
    "src"
  ],
  "scripts": {
    "test": "node --test tests/*.test.js"
  },
  "keywords": [
    "security",
    "csp",
    "hsts",
    "headers",
    "clickjacking",
    "cloudflare-pages",
    "netlify",
    "astro",
    "astro-integration",
    "_headers",
    "csp-hash",
    "content-security-policy"
  ],
  "author": "David Sherlock",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/arraypress/security-headers"
  },
  "peerDependencies": {
    "astro": "^5.0.0 || ^6.0.0 || ^7.0.0"
  },
  "peerDependenciesMeta": {
    "astro": {
      "optional": true
    }
  }
}
